{
	"name": "vis-graph2d",
	"version": "0.1.2",
	"description": "Render interactive 2D charts in notes. Line, bar, and scatter graphs with YAML or JSON authoring, time/numeric/category axes, and full vis Graph2d styling.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.19.40",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "14.0.0",
		"happy-dom": "^15.11.7",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"html-to-image": "^1.11.13",
		"js-yaml": "^4.1.1",
		"obsidian": "latest",
		"vis-timeline": "^8.5.0"
	}
}
